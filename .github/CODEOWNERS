# Paths that need a nastech-agent-core approval before merge. This replaces the
# ``ci-reviewed`` label gate: GitHub requests the review and enforces it
# (ruleset: "Require review from Code Owners"), so CI no longer needs to
# classify these paths, check a label, or rerun jobs when one is added.
#
# Last match wins; every rule below has the same owner, so order is moot.
# Patterns without a leading slash match at any depth.

# Workflows, composite actions, and this file: they decide what CI executes
# and what the autofix job pushes to main. The scripts the workflows run get the
# same review for the same reason.
/.github/                       @NastechResearch/nastech-agent-core
/scripts/ci/                    @NastechResearch/nastech-agent-core

# eslint configs can define custom ``fix`` functions that run arbitrary code.
eslint.config.*                 @NastechResearch/nastech-agent-core
/.prettierrc                    @NastechResearch/nastech-agent-core

# MCP catalog entries define local commands users later install into
# ``mcp_servers``; the installer decides how they are fetched and run.
/optional-mcps/                 @NastechResearch/nastech-agent-core
/nastech_cli/mcp_catalog.py      @NastechResearch/nastech-agent-core

# Files that execute at pip-install or interpreter startup.
/setup.py                       @NastechResearch/nastech-agent-core
/setup.cfg                      @NastechResearch/nastech-agent-core
/sitecustomize.py               @NastechResearch/nastech-agent-core
/usercustomize.py               @NastechResearch/nastech-agent-core
*.pth                           @NastechResearch/nastech-agent-core

# Dependency manifests, resolved pins, and image builds: an edit here changes
# what gets installed and run without touching any reviewed source.
pyproject.toml                  @NastechResearch/nastech-agent-core
package.json                    @NastechResearch/nastech-agent-core
uv.lock                         @NastechResearch/nastech-agent-core
*package-lock.json              @NastechResearch/nastech-agent-core
/flake.lock                     @NastechResearch/nastech-agent-core
/pm/lock.json                   @NastechResearch/nastech-agent-core
*Dockerfile                     @NastechResearch/nastech-agent-core

# The npm supply-chain quarantine (min-release-age) lives here.
.npmrc                          @NastechResearch/nastech-agent-core

# Where PM fetches artifacts from.
/pm/artifact-mirror.json        @NastechResearch/nastech-agent-core

# The installers users pipe into a shell, and the generator for the pins they carry.
/scripts/install.sh             @NastechResearch/nastech-agent-core
/scripts/install.ps1            @NastechResearch/nastech-agent-core
/scripts/install.cmd            @NastechResearch/nastech-agent-core
/scripts/gen-bootstrap-pins.py  @NastechResearch/nastech-agent-core

# The trust model and the scope authority for security reports.
/SECURITY.md                    @NastechResearch/nastech-agent-core

# Each entry pins a third-party repo by sha; editing it changes what users install.
/plugin-catalog/                @NastechResearch/nastech-agent-core
